# Copy to .env on your Hostinger server (same folder as docker-compose.yaml).
# Replace domains and secrets. Do NOT commit .env with real secrets.

# =============================================================================
# Postiz core (required)
# =============================================================================
MAIN_URL=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=https://app.yourdomain.com/api
BACKEND_INTERNAL_URL=http://127.0.0.1:3000
JWT_SECRET=replace-with-long-random-string

DATABASE_URL=postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local
REDIS_URL=redis://postiz-redis:6379
TEMPORAL_ADDRESS=temporal:7233
RUN_CRON=true

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# =============================================================================
# X API (official — posting + DMs)
# =============================================================================
X_API_KEY=
X_API_SECRET=

# =============================================================================
# Custom ingest (postiz container) — backend receives events and sends DMs
# =============================================================================
X_REALTIME_INGEST=custom
X_CUSTOM_INGEST_ENABLED=true
X_CUSTOM_INGEST_AUTO_DM=true
X_CUSTOM_INGEST_SECRET=replace-with-long-random-secret-1

# No duplicate pollers
X_DISABLE_ENGAGEMENT_POLLING=true
TWEETSTREAM_ENABLED=false
XQUIK_ENABLED=false
XQUIK_ENGAGEMENT_POLLING=false
X_ACCOUNT_ACTIVITY_WEBHOOKS_ENABLED=false

# Optional: WebSocket fan-out from monitor (not required for auto-DM)
X_MONITOR_WS_ENABLED=false
X_CUSTOM_WS_CLIENT_ENABLED=false

# =============================================================================
# x-monitor (runs inside postiz container via PM2 when enabled)
# Use http://127.0.0.1:3000 for single-container Docker; http://postiz:5000 only for split-monitor profile
# =============================================================================
X_MONITOR_ENABLED=true
X_MONITOR_POSTIZ_INGEST_URL=http://127.0.0.1:3000
X_MONITOR_INGEST_SECRET=replace-with-long-random-secret-1
X_MONITOR_PUSH_INGEST_HTTP=true
X_MONITOR_SYNC_FROM_DB=true
X_MONITOR_MAX_CHANNELS=50

# Followers + likes via scrape (activity-only: watch counts → scrape on change)
X_MONITOR_FOLLOWERS_ENABLED=true
X_MONITOR_FOLLOWERS_SOURCE=scrape
X_MONITOR_LIKES_ENABLED=true
X_MONITOR_LIKES_SOURCE=scrape
X_MONITOR_WATCH_ENABLED=true
X_MONITOR_WATCH_INTERVAL_MS=60000
X_MONITOR_WATCH_FOLLOWERS=true
X_MONITOR_WATCH_LIKES=true

# How many Postiz-published tweets to track for likes (or use all)
X_MONITOR_WATCH_LIKES_MAX_POSTS=100
X_MONITOR_LIKES_MAX_POSTS=100
# X_MONITOR_WATCH_LIKES_MAX_POSTS=all
# X_MONITOR_LIKES_MAX_POSTS=all

# One X login cookie session for all monitored channels (refresh when scrape fails)
X_MONITOR_SCRAPE_COOKIE=auth_token=...; ct0=...
X_MONITOR_SCRAPE_EXTRA_COOKIES=twid=...; guest_id=...; personalization_id=...

X_MONITOR_SCRAPE_MIN_GAP_MS=4000
X_MONITOR_SCRAPE_CHANNEL_STAGGER_MS=12000
X_MONITOR_SCRAPE_RATE_LIMIT_WAIT_MS=90000
X_MONITOR_FOLLOWERS_SCRAPE_FALLBACK_API=true
X_MONITOR_LIKES_SCRAPE_FALLBACK_API=true

# Optional debug
# X_MONITOR_SCRAPE_DEBUG=false
