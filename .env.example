# Payment / Stripe (billing is ON when a publishable key is set)
# Webhook endpoint: POST https://<YOUR_PUBLIC_API_HOST>/api/stripe
#
# Local development:
# - Use Stripe *test* keys (pk_test_…, sk_test_…) in this file.
# - Run `pnpm run dev:stripe` (needs Stripe CLI installed). It forwards webhooks to
#   http://localhost:3000/api/stripe and prints a temporary whsec_… — put that in
#   STRIPE_WEBHOOK_SECRET or STRIPE_SIGNING_KEY for local only (do not commit it).
# - Set FRONTEND_URL / NEXT_PUBLIC_BACKEND_URL / MAIN_URL to your local URLs (e.g.
#   http://localhost:4200 and http://localhost:4200/api) so Checkout return URLs work.
#
# Stripe Dashboard (non-local): POST …/api/stripe — events:
# invoice.payment_succeeded, customer.subscription.created/updated/deleted
FEE_AMOUNT=0.05
STRIPE_SECRET_KEY=""
# Publishable key (pk_test_... / pk_live_...). Use either:
STRIPE_PUBLISHABLE_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret (whsec_...). Use either:
STRIPE_SIGNING_KEY=""
# STRIPE_WEBHOOK_SECRET=""
STRIPE_SIGNING_KEY_CONNECT=""
# Admin → Billing test Checkout amount (US cents). Stripe requires ≥50 for USD Checkout — use 50 or omit.
# STRIPE_ADMIN_TEST_CHECKOUT_AMOUNT_CENTS=50
# Admin-editable plan prices (JSON on API server). Default: .data/billing-plan-prices.json
# BILLING_PLAN_PRICES_FILE=.data/billing-plan-prices.json
# Set to true to ignore Stripe keys and skip billing UI / first-billing gate (local or temporary).
# Use on frontend + backend; NEXT_PUBLIC_ copy is optional (helps if only public env is inlined).
# POSTIZ_DISABLE_STRIPE_BILLING=true
# NEXT_PUBLIC_POSTIZ_DISABLE_STRIPE_BILLING=true

# Profile / Follow automation sidebar + routes (defaults before admin saves flags in Admin → Automations)
# AUTOMATION_PAGES_PROFILE_PUBLIC=false
# AUTOMATION_PAGES_FOLLOW_PUBLIC=false
# AUTOMATION_PAGES_TWEET_PUBLIC=false  # deprecated alias of PROFILE

