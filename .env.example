# Configuration reference: http://docs.postiz.com/configuration/reference

# === Required Settings
DATABASE_URL="postgresql://postiz-local:postiz-local-pwd@localhost:5432/postiz-db-local"

# Production / Railway: leave unset so restarts do NOT run `prisma db push` (prevents
# Mastra mastra_ai_spans ghost columns). Set to true only once when you changed schema.prisma:
# RUN_PRISMA_DB_PUSH_ON_START=true
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"

# === This needs to be exactly the URL you're accessing Postiz on
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"

## Remember to set your public internet IP address in the allow-list for the API token.
##
## Cloudflare is currently required to save things like social media avatars for accounts.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
CLOUDFLARE_BUCKET_URL="https://your-bucket-url.r2.cloudflarestorage.com/"
CLOUDFLARE_REGION="auto"

# === Common optional Settings

## This is a dummy key, you must create your own from Resend.
## If this variable exists, user activation is required.
## If it is commented out, users are activated automatically.
#RESEND_API_KEY="RzeTwHijvxvPUerScFcenUZUALuQJzSaGSMJ"
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
#DISABLE_REGISTRATION=false

# Where will social media icons be saved - local or cloudflare.
STORAGE_PROVIDER="local"

# Local disk path where the API writes uploads (must match your Railway volume mount path).
# Official Docker image uses /uploads. On Railway (backend service): add a Volume, mount path
# /uploads, and set UPLOAD_DIRECTORY=/uploads here. Each Railway service has its own volume —
# backend and orchestrator do not share one disk; for split workers + API use R2, or one
# service that runs both, or ensure posted media is only URLs the worker can fetch (HTTPS).
#UPLOAD_DIRECTORY="/uploads"

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Social Media API Settings
X_API_KEY=""
X_API_SECRET=""
# X plug pollers (default 300000 = 5 minutes each when unset).
# For faster engagement DMs without webhooks, set X_ENGAGEMENT_POLL_INTERVAL_MS=30000 (30s minimum).
#X_FOLLOWER_DM_POLL_INTERVAL_MS=300000
#X_PROFILE_AUTOMATIONS_POLL_INTERVAL_MS=300000
#X_ENGAGEMENT_POLL_INTERVAL_MS=300000
# Engagement poller: max published posts scanned per tick (default 5)
#X_ENGAGEMENT_MAX_POSTS_PER_TICK=5
# Max DMs attempted per poller tick per integration (default 3; X allows 15 per 15 min)
#X_PLUG_DM_BATCH_MAX_PER_TICK=3
#X_PLUG_DM_WINDOW_MAX=15
# X follow rate limits (per connected channel). Follow automations enforce daily cap only.
#X_FOLLOW_RATE_LIMIT_MAX=50
#X_FOLLOW_RATE_LIMIT_WINDOW_MS=900000
#X_FOLLOW_DAILY_LIMIT_MAX=400
#X_FOLLOW_DAILY_LIMIT_WINDOW_MS=86400000
# Follow queue persistence (required on Docker — mount a volume to this path or set a custom file)
#X_FOLLOW_QUEUE_FILE=.data/x-follow-queue.json
# Poll interval for due 15-minute batches (backend only — POSTIZ_WORKER=backend via pnpm dev:backend)
#X_FOLLOW_QUEUE_POLL_MS=60000
#X_FOLLOW_QUEUE_PROCESSING_TIMEOUT_MS=600000
#X_FOLLOW_QUEUE_MAX_PENDING=10000
#
# --- Real-time engagement DMs (likes / replies / reposts → auto-DM) ---
#
# Tweetmax own detector (X filtered STREAM push — NOT polling — + WebSocket like TweetStream):
#   Run TWO processes: pnpm run dev:backend  +  pnpm run dev:x-monitor
#
# Postiz backend:
#   X_REALTIME_INGEST=custom
#   X_CUSTOM_INGEST_ENABLED=true
#   X_CUSTOM_INGEST_SECRET=long-random-secret
#   X_ACTIVITY_STREAM_ENABLED=true
#   X_ACTIVITY_STREAM_SECRET=another-long-secret
#   TWEETSTREAM_ENABLED=false
#   X_ACCOUNT_ACTIVITY_WEBHOOKS_ENABLED=false
#   X_DISABLE_ENGAGEMENT_POLLING=true
#
# X monitor app (apps/x-monitor) — uses same X_API_KEY / X_API_SECRET as Postiz:
#   X_MONITOR_ENABLED=true
#   X_MONITOR_WS_ENABLED=true
#   X_MONITOR_WS_PORT=8089
#   X_MONITOR_WS_TOKEN=optional-ws-auth
#   X_MONITOR_INGEST_SECRET=long-random-secret
#   X_MONITOR_POSTIZ_INGEST_URL=http://localhost:3000
#   X_MONITOR_SYNC_FROM_DB=true
#   X_MONITOR_MAX_CHANNELS=50
#   X_MONITOR_PUSH_INGEST_HTTP=true
#   X_MONITOR_FOLLOWERS_ENABLED=true
#   X_MONITOR_FOLLOWERS_INTERVAL_MS=60000
#
# Flow: X pushes tweets on stream → monitor → HTTP POST /api/x/activity-ingest → Postiz DM
#       New followers: poll per channel (api or optional scrape) → same ingest path
#       monitor also broadcasts: ws://localhost:8089/ws?token=...
# Realtime likes/follows WITHOUT polling credits (VIP only — X pushes webhooks):
#   X_REALTIME_HYBRID=true
#   X_ACCOUNT_ACTIVITY_WEBHOOKS_ENABLED=true
#   X_ACCOUNT_ACTIVITY_WEBHOOK_URL=https://your-api.example.com/api/x/account-activity
#   X_ACCOUNT_ACTIVITY_VIP_HANDLES=brand1,brand2,brand3
#   X_ACCOUNT_ACTIVITY_VIP_MAX=3
#   X_ACCOUNT_ACTIVITY_DISABLE_POLLING=true
# (Stream monitor handles replies/@mentions for up to 50 handles — no AAA sub slot each)
#
# Followers (default: on with monitor; interval poll off when source=scrape — watch then scrape):
#X_MONITOR_FOLLOWERS_ENABLED=false
#X_MONITOR_FOLLOWERS_POLL=false
#X_MONITOR_FOLLOWERS_INTERVAL_MS=120000
# Source: api (default, uses your X API credits) or scrape (no v2 credits — unofficial, fragile):
#X_MONITOR_FOLLOWERS_SOURCE=scrape
# Activity-only (default when scrape): stream + count watcher → scrape; no interval list polling:
#X_MONITOR_ACTIVITY_ONLY=true
#X_MONITOR_LIKES_ENABLED=true
#X_MONITOR_LIKES_POLL=false
#X_MONITOR_LIKES_SOURCE=scrape
#X_MONITOR_SCRAPE_COOKIE=auth_token=...; ct0=...
#X_MONITOR_SCRAPE_EXTRA_COOKIES=twid=...; kdt=...  (copy all x.com cookies if 401 persists)
#X_MONITOR_SCRAPE_DEBUG=true
#X_MONITOR_SCRAPE_MIN_GAP_MS=4000
#X_MONITOR_SCRAPE_CHANNEL_STAGGER_MS=12000
#X_MONITOR_SCRAPE_RATE_LIMIT_WAIT_MS=90000
#X_MONITOR_FOLLOWERS_SCRAPE_FALLBACK_API=true
#X_MONITOR_LIKES_SCRAPE_FALLBACK_API=true
#X_MONITOR_SCRAPE_FOLLOWERS_QUERY_ID=pmxFA6014EImPZ71HRMd-A
#X_MONITOR_SCRAPE_USER_QUERY_ID=NIMhKFdUHjteQVL8t_d_wQ
#X_MONITOR_SCRAPE_LIKERS_QUERY_ID=lI07N6Otw2fx5SpnDwWyMA
#
# Stream-triggered scrape (near-realtime when someone replies/mentions — NOT for silent likes/follows):
#X_MONITOR_REACTIVE_SCRAPE=true
#X_MONITOR_REACTIVE_SCRAPE_DEBOUNCE_MS=2000
#X_MONITOR_REACTIVE_SCRAPE_FOLLOWERS=true
#
# Change watcher (watch public counts → full scrape on increase; closest to "WS watch then scrape"):
#X_MONITOR_WATCH_ENABLED=true
#X_MONITOR_WATCH_INTERVAL_MS=60000
# Like-count watcher: newest N published Postiz tweets per channel (default 2). Use 100 or `all` / 0 for every PUBLISHED post in DB (heavy).
#X_MONITOR_WATCH_LIKES_MAX_POSTS=2
#X_MONITOR_WATCH_SCRAPE_MIN_GAP_MS=1000
#X_MONITOR_WATCH_FOLLOWERS=true
#X_MONITOR_WATCH_LIKES=true
# Connect: ws://localhost:8089/ws — messages: watch_signal then activity
#X_MONITOR_LIKES_ENABLED=true
#X_MONITOR_LIKES_INTERVAL_MS=600000
# Full liker scrape: same limits as above (default 3). `all` or 0 = every PUBLISHED post with releaseId on that channel.
#X_MONITOR_LIKES_MAX_POSTS=3
#
# Manual ingest (no monitor): POST /api/x/activity-ingest with Bearer secret
# Site UI: wss://YOUR-API/api/x/activity-stream?token=SECRET&handle=brand
#
#X_CUSTOM_INGEST_ENABLED=true
#X_CUSTOM_INGEST_SECRET=long-random-secret
#X_CUSTOM_INGEST_AUTO_DM=true
#X_MONITOR_ENABLED=true
#X_MONITOR_WS_ENABLED=true
#X_MONITOR_WS_PORT=8089
#X_MONITOR_POSTIZ_INGEST_URL=http://localhost:3000
#X_MONITOR_INGEST_SECRET=long-random-secret
#X_MONITOR_MAX_CHANNELS=50
#X_MONITOR_SYNC_FROM_DB=true
#X_MONITOR_STREAM_RECONNECT_MS=5000
#X_MONITOR_STREAM_CONNECTION_LIMIT_WAIT_MS=60000
#X_CUSTOM_WS_CLIENT_ENABLED=false
#X_CUSTOM_WS_URL=ws://127.0.0.1:8089/ws
#X_CUSTOM_WS_TOKEN=
#X_CUSTOM_WS_RECONNECT_MS=5000
#
# TweetStream alternative (third-party ingest, not your own WS):
#   X_REALTIME_INGEST=tweetstream
#   TWEETSTREAM_ENABLED=true
#   TWEETSTREAM_API_KEY=...
#
# Alternative: X Account Activity webhooks (typically seconds). Requires Pro ($5k/mo)
# or Enterprise on your X developer app, DM permission, and a public HTTPS backend URL.
#X_REALTIME_INGEST=webhooks
#X_ACCOUNT_ACTIVITY_WEBHOOKS_ENABLED=true
#X_ACCOUNT_ACTIVITY_WEBHOOK_URL="https://your-api.example.com/api/x/account-activity"
# Stream X engagement events to your website (WebSocket + HTTP poll). Works with webhooks or TweetStream.
#X_ACTIVITY_STREAM_ENABLED=true
#X_ACTIVITY_STREAM_SECRET=your-long-random-secret
#X_ACTIVITY_STREAM_RECENT_MAX=200
# If you created the webhook in the X portal, paste its id here (avoids WebhookLimitExceeded).
#X_ACCOUNT_ACTIVITY_WEBHOOK_ID=""
# Optional delay before webhook DM send (ms). Default 0 = send immediately after event.
#X_WEBHOOK_DM_DELAY_MS=0
# When webhooks work, disable 5-minute pollers to avoid duplicate work (keep false until verified).
# Requires X_ACCOUNT_ACTIVITY_WEBHOOKS_ENABLED=true.
#X_ACCOUNT_ACTIVITY_DISABLE_POLLING=true
# Disable engagement/profile Temporal pollers without AAA (e.g. TweetStream for replies; keep liker poll for likes).
#X_DISABLE_ENGAGEMENT_POLLING=false
# Fallback without Pro: poll every 30s (minimum). Still not true realtime.
#X_ENGAGEMENT_POLL_INTERVAL_MS=30000
#
# --- TweetStream WebSocket (third-party realtime; not official X API) ---
# Production: set RUN_CRON=true on the backend worker only (not orchestrator).
# dev scripts set POSTIZ_WORKER=backend | orchestrator automatically.
# Local dev: starts automatically when NODE_ENV is not production, or set TWEETSTREAM_START_IN_DEV=true.
# Detection only — Postiz still sends DMs via official X OAuth.
# Basic plan tracks up to 50 X handles. Trial = 1 WebSocket (backend only; stop tweetstream-cli listen).
#
# TweetStream-first auto-DM (recommended):
#   • Reply / comment / repost → instant via WebSocket (autoDmEngagers on that post)
#   • New / refollow follower → instant via WebSocket follow event (autoDmFollowers plug on profile)
#   • Like-only auto-DM → NOT on WebSocket; keep X_ENGAGEMENT_POLL_INTERVAL_MS as a slow backup (e.g. 300000)
# Run: pnpm run dev:backend (WebSocket) + pnpm run dev:orchestrator (workflows). One backend process only.
#TWEETSTREAM_ENABLED=true
#TWEETSTREAM_API_KEY=""
# Optional: wss://ws.tweetstream.io/ws and https://api.tweetstream.io
#TWEETSTREAM_WS_URL="wss://ws.tweetstream.io/ws"
#TWEETSTREAM_API_BASE="https://api.tweetstream.io"
# Use TweetStream for follower DMs when WS is connected; poller fallback only if WS is down.
#TWEETSTREAM_DISABLE_FOLLOWER_POLLING=true
#X_ENGAGEMENT_POLL_INTERVAL_MS=300000
#X_ENGAGEMENT_MAX_POSTS_PER_TICK=3
# While WS is active, skip poller liker fetches (reply/RT use socket). Set true to also poll likes.
#TWEETSTREAM_POLL_LIKES_WHEN_WS=false
# Backup reply DMs via poller when WS is up (default on). Uses 1 read/post/tick.
#TWEETSTREAM_POLL_REPLIES_WHEN_WS=true
# Track all connected X channels (default: only channels with autoDm* plugs active).
#TWEETSTREAM_TRACK_ALL_X=false
# Push recent events to Redis for GET /x/tweetstream/events (website / dashboard).
#TWEETSTREAM_PUBLISH_EVENTS=true
#TWEETSTREAM_RECENT_EVENTS_MAX=200
# Trial = 1 WebSocket. Delay start after backend boot to avoid 429 (ms, default 45000).
#TWEETSTREAM_WS_START_DELAY_MS=45000
# Set true to debug without opening a WebSocket (likes still use poller).
#TWEETSTREAM_DISABLE_WEBSOCKET=false

# --- Xquik Webhook/Polling (optional alternative to TweetStream/X AAA) ---
# Enable signed webhook ingestion at POST /api/x/xquik/webhook
#XQUIK_ENABLED=false
#XQUIK_API_BASE="https://xquik.com/api/v1"
#XQUIK_API_KEY=""
# Public HTTPS webhook URL (required for local dev — use ngrok, not localhost):
#XQUIK_WEBHOOK_URL="https://YOUR-SUBDOMAIN.ngrok-free.app/api/x/xquik/webhook"
# Auto create/list webhook on backend start (default when XQUIK_WEBHOOK_URL is set)
#XQUIK_WEBHOOK_AUTO_REGISTER=true
# HMAC secret from POST /webhooks (returned once). Verify headers:
# X-Xquik-Timestamp, X-Xquik-Nonce, X-Xquik-Signature (sha256=HMAC of timestamp.nonce.rawBody)
#XQUIK_WEBHOOK_SECRET=""
# Fast polling helpers (best-effort <20s; higher cost). Min 10000ms.
#XQUIK_LIKES_POLL_INTERVAL_MS=20000
#XQUIK_FOLLOWERS_POLL_INTERVAL_MS=20000
# Fast Xquik poll loop on backend (default 20s). Works with X_DISABLE_ENGAGEMENT_POLLING=true.
#XQUIK_ENGAGEMENT_POLL_INTERVAL_MS=20000
#XQUIK_ENGAGEMENT_POLLING=true
# Prioritize posts with inbound replies; defaults 8 posts / 5 DMs per tick
#XQUIK_ENGAGEMENT_MAX_POSTS_PER_TICK=8
#XQUIK_PLUG_DM_BATCH_MAX_PER_TICK=5
# When XQUIK_ENABLED, disable TweetStream WebSocket (default true).
#XQUIK_DISABLE_TWEETSTREAM=true
# Webhook/monitor events (add tweet.like/tweet.favorite on monitors if Xquik UI offers them)
# Follower welcome DMs use GET /x/users/:id/followers polling — not a monitor webhook type.
#XQUIK_WEBHOOK_EVENT_TYPES=tweet.new,tweet.reply,tweet.retweet,tweet.quote,tweet.mention,tweet.like,tweet.favorite

